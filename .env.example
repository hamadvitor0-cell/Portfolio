# Server-side contact forwarding to HamadFlow.
HAMADFLOW_LEADS_ENDPOINT=
HAMADFLOW_LEAD_SECRET=

# Anonymous page views and interaction events forwarded server-side to HamadFlow.
HAMADFLOW_ANALYTICS_ENDPOINT=
HAMADFLOW_ANALYTICS_SECRET=
